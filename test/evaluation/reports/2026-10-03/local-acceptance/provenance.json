{
  "measured_at": "2026-10-03T06:38:23.558039+00:00",
  "scope": "Bounded source-grounded P1 fixes; explicit selections, literal comparisons and row-preserving evidence; installed defaults, unchanged corpus, isolated app",
  "git_head": "f9f3a8baa386e9a3346572dd0241edbc00d1ec7f",
  "config": "http:\n  addr: \"127.0.0.1:18113\"\n  read_timeout: 5s\n  write_timeout: 0s  # 0s = none: streamed answers run longer than a fixed write deadline\n  idle_timeout: 120s\n  startup_timeout: 30s\n  shutdown_timeout: 10s\n  readiness_timeout: 15s\n\n# Diagnostic pprof endpoints are opt-in and loopback-only. Use an SSH tunnel\n# or an equivalent protected local access path when profiling a remote host.\nprofiling:\n  enabled: false\n  addr: \"127.0.0.1:6063\"\n\nmiddleware:\n  timeout: 30s\n  logger:\n    level: dev  # dev | prod\n\ndocuments:\n  mode: \"upload-only\"       # upload-only | mirror; mirror removes missing files under documents.paths\n  paths:\n    - \"samples\"\n  ignore_patterns: []\n\ningest:\n  max_attempts: 3\n  initial_interval: 500ms\n  max_interval: 10s\n  multiplier: 2.0\n  workers: 8\n  max_file_bytes: 16777216       # 16 MiB per document upload/source file\n  max_upload_bytes: 67108864    # 64 MiB per multipart request\n  embed_batch_size: 64           # bound each Ollama embedding request\n  max_chunks_per_file: 10000     # reject pathological documents before indexing\n\nqdrant:\n  addr: \"localhost:17444\"\n  collection: \"p1_subject_documents_20261003\"\n  top_k: 5\n  prefetch_mul: 5  # store-level candidate multiplier for hybrid search legs\n\nembedder:\n  provider: \"ollama\"\n  model: \"embeddinggemma-300m-q8:latest\"\n  ollama_addr: \"http://localhost:11434\"\n  dimensions: 768\n  request_timeout: 60s\n  query_prefix: \"task: search result | query: \"   # prepended to queries at search time (EmbeddingGemma task instruction; empty = off)\n  # num_gpu: 0               # optional: keep embeddings on CPU when a larger answer model occupies the GPU; omitted = Ollama placement\n  document_prefix: \"title: none | text: \"          # prepended to chunks at ingest time; requires reindex when changed\n  max_input_chars: 8000                            # rune-clamp on dense embed inputs so Ollama never truncates silently (0 = off)\n\nchunker:\n  provider: \"recursive\"  # recursive | sentence-window (measured 2026-09-27, ADR 0033: recursive stays)\n  chunk_size: 512\n  chunk_overlap: 64\n  window_size: 3          # sentences before+after each sentence (sentence-window only)\n\nsearch:\n  max_query_chars: 8192\n  max_fragments: 16\n  max_concurrent_fragments: 8\n  max_top_k: 50\n  max_chunks_per_file: 3\n  fusion:\n    enabled: false # enable only after offline golden-set evidence supports the candidate policy\n    rrf_k: 60\n    dense_weight: 1.0\n    bm25_weight: 1.0\n    exact_match_boost: 0.0\n    header_match_boost: 0.0\n    min_exact_tokens: 1\n    min_header_tokens: 1\n    profiles: {}\n\nreranker:\n  enabled: false   # opt in only after a measured gain on the current embedding profile\n  addr: \"http://localhost:5002\"\n  model: \"BAAI/bge-reranker-v2-m3\" # swappable sidecar cross-encoder (env RERANKER_MODEL overrides); revert to cross-encoder/ms-marco-MiniLM-L-6-v2 for the tiny/fast baseline\n  candidate_mul: 4     # fetch topK*4 candidates before reranking (more headroom for the reranker to reorder)\n  request_timeout: 30s\n  adaptive_enabled: false # opt in until release-gated judgments confirm no quality regression\n  adaptive_margin_threshold: 0.01 # rerank when dense/lexical top results disagree or fused top margin is below 1%\n\n# Local inference profile. LLM and embedding concurrency is owned by the\n# Ollama scheduler (OLLAMA_NUM_PARALLEL) plus each role's request_timeout, so\n# no client-side gate is imposed. The reranker keeps an explicit client-side\n# queue; it is CPU by default for portable laptop operation \u2014 use the GPU\n# Compose override with device=cuda only when Ollama and the reranker have a\n# measured hardware budget.\ninference:\n  profile: \"local\"\n  ollama:\n    keep_alive: 5m\n  reranker:\n    max_concurrent: 1\n    queue_timeout: 30s\n    device: \"cpu\"\n    backend: \"torch\"\n\n# Process-local operation gates (bounded, finite queues). Indexing is\n# single-writer; destructive mutations (document reset, chat edits and\n# deletions) never run concurrently with an indexing pass. A request that\n# waits longer than queue_timeout fails fast instead of piling up. LLM and\n# embedding concurrency is NOT gated here \u2014 the Ollama scheduler owns it.\n# These limits coordinate one API process only; they are not distributed.\ngates:\n  indexing:\n    max_concurrent: 1\n    queue_timeout: 5s\n  destructive:\n    max_concurrent: 1\n    queue_timeout: 10s\n\nenrichment:\n  # Index-time LLM enrichment (uses Ollama; one-time cost per chunk, zero\n  # query-time latency). Changing these requires a reindex to take effect.\n  request_timeout: 120s\n  contextual:\n    enabled: false          # Anthropic-style LLM-written situational context prepended to each chunk before embedding\n    ollama_addr: \"http://localhost:11434\"\n    model: \"gemma3:1b\"\n\nsemantic_cache:\n  enabled: true     # set true to enable; requires no extra infra (reuses Qdrant)\n  collection: \"p1_subject_cache_20261003\"\n  threshold: 0.90    # cosine similarity cutoff (0.85=permissive, 0.95=strict)\n  ttl: 24h           # 0 = no expiry\n\ngenerator:\n  enabled: true      # set true + ensure the Ollama model is pulled; the dashboard or POST /api/v1/turns with generate=true\n  ollama_addr: \"http://localhost:11434\"\n  model: \"gemma3:4b\"  # LLM for answer generation; use instruct models. gemma3:4b passes the generation gate (ADR 0034: faithfulness 0.881 / relevancy 0.803 vs 1b 0.750/0.756) at ~9x answer latency; gemma3:1b is the low-latency fallback\n  request_timeout: 120s\n  max_output_tokens: 512 # bound answer generation; prevents an unending stream\n  num_ctx: 4096          # pin the Ollama context window: prompt budget + instructions + output must fit (GENERATOR_NUM_CTX)\n\nchat:\n  # Chat use-case tuning: prompt assembly and the streaming turn lifecycle.\n  max_context_tokens: 2800  # token budget for retrieved chunks (~70% of 4k ctx window)\n  event_buffer: 4096\n  max_event_log_bytes: 1048576   # 1 MiB replay log per turn\n  max_retained_turns: 64\n  finished_turn_ttl: 10m\n  persist_timeout: 5s\n\nrewriter:\n  # Conversational query rewriting (Rewrite-Retrieve-Read): follow-up turns\n  # are rewritten into standalone search queries against the session's last\n  # `turns` turns before retrieval, so \"what about the second one?\" stops\n  # searching garbage. Skipped when a session has no prior turns; any\n  # rewrite failure falls back to the raw query. Costs +1 LLM call per\n  # follow-up turn.\n  enabled: true\n  turns: 4           # prior turns fed to the rewriter\n  request_timeout: 8s\n  ollama_addr: \"http://localhost:11434\"\n  model: \"gemma3:1b\"\n\nhistory:\n  enabled: true              # persists chat sessions/turns to Qdrant, no extra infra\n  collection: \"p1_subject_history_20261003\"\n  session_page_size: 50      # sidebar sessions returned per request\n  turn_page_size: 500        # Qdrant scroll page used while loading one session\n\ndocling:\n  enabled: false             # enable PDF intake when the Docling sidecar is available\n  addr: \"http://localhost:5003\"\n  request_timeout: 120s\n",
