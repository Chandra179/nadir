# Qdrant
QDRANT_ADDR=localhost:6334
QDRANT_COLLECTION=documents_chunks

# Compose source mount (relative host directory)
SOURCE_DIR=./samples

# Embedder
OLLAMA_ADDR=http://localhost:11434
EMBEDDER_API_KEY=

# LLM roles (set explicitly even when they share the same Ollama server)
GENERATOR_ADDR=http://localhost:11434
GENERATOR_MODEL=gemma3:1b
REWRITE_ADDR=http://localhost:11434
REWRITE_MODEL=gemma3:1b
HYPE_ADDR=http://localhost:11434
HYPE_MODEL=gemma3:1b
CONTEXTUAL_ADDR=http://localhost:11434
CONTEXTUAL_MODEL=gemma3:1b

# Reranker
RERANKER_ADDR=http://localhost:5002
RERANKER_ENABLED=true
RERANKER_BACKEND=torch
RERANKER_DEVICE=cpu
RERANKER_GPU=0
RERANKER_BAKE_QUANTIZED=0
RERANKER_MAX_LENGTH=512
DOCLING_ENABLED=false
DOCLING_ADDR=http://localhost:5003
DOCKER_DOCLING_ADDR=http://host.docker.internal:5003

# Logging
LOGGER_LEVEL=dev

# Semantic cache
SEMANTIC_CACHE_THRESHOLD=0.90
