# Qdrant
QDRANT_ADDR=localhost:6334
QDRANT_COLLECTION=documents_chunks_reading
# Optional HNSW tuning (0 or unset keeps the Qdrant default). Build values apply
# to collections created afterwards (first start or a reset).
# QDRANT_HNSW_M=16
# QDRANT_HNSW_EF_CONSTRUCT=100
# QDRANT_HNSW_FULL_SCAN_THRESHOLD=10000
# QDRANT_INDEXING_THRESHOLD=20000
# QDRANT_HNSW_EF=128

# Optional directory ingestion with deploy/compose/compose.sources.yaml.
# Use an existing absolute host directory. The base stack uses uploads.
# DOCUMENTS_DIR=/absolute/path/to/documents

# Embedder
OLLAMA_ADDR=http://localhost:11434
EMBEDDER_API_KEY=
EMBEDDER_MODEL=embeddinggemma-300m-q8:latest
EMBEDDER_DIMENSIONS=768
EMBEDDER_QUERY_PREFIX="task: search result | query: "
EMBEDDER_DOCUMENT_PREFIX="title: none | text: "

# LLM roles (set explicitly even when they share the same Ollama server)
GENERATOR_PROVIDER=ollama
GENERATOR_ADDR=http://localhost:11434
GENERATOR_MODEL=qwen3.5:4b
GENERATOR_THINK=false
# Workers AI (GENERATOR_PROVIDER=cloudflare): set GENERATOR_MODEL to a Workers AI
# id such as @cf/meta/llama-3.2-3b-instruct. Keep the token out of version control.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
REWRITE_ADDR=http://localhost:11434
REWRITE_MODEL=qwen3.5:4b
REWRITE_THINK=false
CONTEXTUAL_ADDR=http://localhost:11434
CONTEXTUAL_MODEL=qwen3.5:4b
CONTEXTUAL_THINK=false

# Reranker
RERANKER_ADDR=http://localhost:5002
RERANKER_ENABLED=false
RERANKER_BACKEND=torch
RERANKER_DEVICE=cpu
RERANKER_GPU=0
RERANKER_MAX_LENGTH=512
DOCLING_ENABLED=false
DOCLING_ADDR=http://localhost:5003
# Podman Compose override: Docling address as seen from the app container
HOST_DOCLING_ADDR=http://host.containers.internal:5003

# Logging
LOGGER_LEVEL=dev

# Semantic cache
SEMANTIC_CACHE_THRESHOLD=0.90
