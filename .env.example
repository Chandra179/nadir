# Qdrant
QDRANT_ADDR=localhost:6334
QDRANT_COLLECTION=documents_chunks_reading
# Optional HNSW tuning (0 or unset keeps the Qdrant default). Build values apply
# to collections created afterwards (first start or a reset).
# QDRANT_HNSW_M=16
# QDRANT_HNSW_EF_CONSTRUCT=100
# QDRANT_HNSW_FULL_SCAN_THRESHOLD=10000
# QDRANT_INDEXING_THRESHOLD=20000
# QDRANT_HNSW_EF=128

# Optional directory ingestion with deploy/compose/compose.sources.yaml.
# Use an existing absolute host directory. The base stack uses uploads.
# DOCUMENTS_DIR=/absolute/path/to/documents

# Embedder
OLLAMA_ADDR=http://localhost:11434
EMBEDDER_API_KEY=
EMBEDDER_PROVIDER=ollama
EMBEDDER_MODEL=embeddinggemma-300m-q8:latest
EMBEDDER_DIMENSIONS=768
EMBEDDER_QUERY_PREFIX="task: search result | query: "
EMBEDDER_DOCUMENT_PREFIX="title: none | text: "

# LLM roles (set explicitly even when they share the same Ollama server)
GENERATOR_PROVIDER=ollama
GENERATOR_ADDR=http://localhost:11434
GENERATOR_MODEL=qwen3.5:4b
GENERATOR_THINK=false
# Workers AI embeddings: EMBEDDER_PROVIDER=cloudflare with EMBEDDER_MODEL set to a
# Workers AI id and EMBEDDER_DIMENSIONS matching it. Reindex after switching.
# Workers AI (GENERATOR_PROVIDER=cloudflare): set GENERATOR_MODEL to a Workers AI
# id such as @cf/meta/llama-3.2-3b-instruct. REWRITE_PROVIDER and
# CONTEXTUAL_PROVIDER accept cloudflare too and reuse the same account and token
# (set REWRITE_MODEL / CONTEXTUAL_MODEL to Workers AI ids). Keep the token out of
# version control.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Chat history in Cloudflare D1: HISTORY_PROVIDER=d1 with CLOUDFLARE_D1_DATABASE_ID (the
# token needs D1 edit access). Starts with empty history; Qdrant history is not migrated.
HISTORY_PROVIDER=qdrant
# Documents in Vectorize + D1: DOCUMENTS_STORE=cloudflare with CLOUDFLARE_D1_DATABASE_ID and an
# existing cosine Vectorize index (--dimensions=EMBEDDER_DIMENSIONS) that already has the string
# metadata indexes file_key, header_key and sha_key (create them before storing any vector).
# Starts with an empty corpus: reset and reindex. See docs/adr/0043.
DOCUMENTS_STORE=qdrant
CLOUDFLARE_DOCUMENTS_INDEX=
# Semantic cache in Vectorize + KV: SEMANTIC_CACHE_PROVIDER=cloudflare with an existing
# cosine Vectorize index (--dimensions=EMBEDDER_DIMENSIONS) and a KV namespace; the token needs
# Vectorize and KV edit access.
SEMANTIC_CACHE_PROVIDER=qdrant
CLOUDFLARE_VECTORIZE_INDEX=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_D1_DATABASE_ID=
REWRITE_PROVIDER=ollama
REWRITE_ADDR=http://localhost:11434
REWRITE_MODEL=qwen3.5:4b
REWRITE_THINK=false
CONTEXTUAL_PROVIDER=ollama
CONTEXTUAL_ADDR=http://localhost:11434
CONTEXTUAL_MODEL=qwen3.5:4b
CONTEXTUAL_THINK=false

# Reranker
RERANKER_ADDR=http://localhost:5002
RERANKER_ENABLED=false
RERANKER_BACKEND=torch
RERANKER_DEVICE=cpu
RERANKER_GPU=0
RERANKER_MAX_LENGTH=512
DOCLING_ENABLED=false
DOCLING_ADDR=http://localhost:5003
# Podman Compose override: Docling address as seen from the app container
HOST_DOCLING_ADDR=http://host.containers.internal:5003

# Logging
LOGGER_LEVEL=dev

# Semantic cache
SEMANTIC_CACHE_THRESHOLD=0.90
