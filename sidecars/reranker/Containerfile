FROM docker.io/library/python:3.12-slim

WORKDIR /app

# Model is swappable at build time via --build-arg RERANKER_MODEL=... and at
# runtime via the RERANKER_MODEL env var (see main.py).
ARG RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENV RERANKER_MODEL=${RERANKER_MODEL}

# GPU=1 installs the CUDA torch build instead of the CPU wheel (see
# requirements-gpu.txt); pair with the deploy/compose/compose.gpu.yaml override,
# which sets this from RERANKER_GPU=1 and passes the host GPU through CDI.
ARG GPU=0

COPY requirements.txt requirements-cpu.txt requirements-gpu.txt ./
# --timeout/--retries: the CUDA torch wheel is a multi-hundred-MB download;
# pip's 15 s default read timeout aborts mid-wheel on slow links.
RUN if [ "$GPU" = "1" ]; then \
        pip install --no-cache-dir --timeout 120 --retries 10 -r requirements.txt -r requirements-gpu.txt; \
    else \
        pip install --no-cache-dir --timeout 120 --retries 10 -r requirements.txt -r requirements-cpu.txt; \
    fi

# Pre-download the model so container start doesn't hit HuggingFace.
RUN python -c "from sentence_transformers import CrossEncoder; CrossEncoder('$RERANKER_MODEL')"

COPY main.py .

EXPOSE 5002
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5002"]
